# ============================================================================
# Color Transfer Framework v2.0 - GPU-Enabled Production Dockerfile
# Multi-stage build with CUDA support for GPU acceleration
# ============================================================================
#
# Build arguments:
#   CUDA_VERSION: CUDA version (default: 11.8.0)
#   PYTHON_VERSION: Python version (default: 3.11)
#   INTERFACE: Which interface to run (api|web|web_enhanced|tui|cli)
#
# Build example:
#   docker build -f Dockerfile.gpu --build-arg INTERFACE=api -t color-transfer:gpu .
#
# Run example (requires NVIDIA Docker runtime):
#   docker run --gpus all -p 8000:8000 color-transfer:gpu
#
# ============================================================================

ARG CUDA_VERSION=11.8.0
ARG PYTHON_VERSION=3.11

# ============================================================================
# Stage 1: Builder - Install dependencies with CUDA support
# ============================================================================

FROM nvidia/cuda:${CUDA_VERSION}-cudnn8-devel-ubuntu22.04 as builder

# Install Python and build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-dev \
    python3-pip \
    gcc \
    g++ \
    make \
    libopencv-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy requirements
COPY requirements.txt .

# Install Python dependencies with GPU support
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --user -r requirements.txt && \
    pip install --no-cache-dir --user torch torchvision --index-url https://download.pytorch.org/whl/cu118

# ============================================================================
# Stage 2: Runtime - Minimal production image with CUDA runtime
# ============================================================================

FROM nvidia/cuda:${CUDA_VERSION}-cudnn8-runtime-ubuntu22.04 as runtime

ARG PYTHON_VERSION=3.11
ARG INTERFACE=api
ENV INTERFACE=${INTERFACE}

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_HOME=/app \
    APP_USER=appuser \
    APP_UID=1000 \
    APP_GID=1000 \
    API_PORT=8000 \
    WEB_PORT=5000 \
    WORKERS=4 \
    PATH="/home/appuser/.local/bin:${PATH}" \
    # GPU settings
    CUDA_VISIBLE_DEVICES=0 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python${PYTHON_VERSION} \
    python3-pip \
    libgomp1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1-mesa-glx \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g ${APP_GID} ${APP_USER} && \
    useradd -m -u ${APP_UID} -g ${APP_GID} -s /bin/bash ${APP_USER}

WORKDIR ${APP_HOME}

# Copy Python dependencies from builder
COPY --from=builder --chown=${APP_USER}:${APP_USER} /root/.local /home/${APP_USER}/.local

# Copy application code
COPY --chown=${APP_USER}:${APP_USER} color_transfer_framework/ ./color_transfer_framework/
COPY --chown=${APP_USER}:${APP_USER} .env.example ./.env.example

# Create directories
RUN mkdir -p logs data/cache data/results data/uploads && \
    chown -R ${APP_USER}:${APP_USER} logs data

USER ${APP_USER}

# GPU health check script
COPY --chown=${APP_USER}:${APP_USER} <<'EOF' /app/gpu_check.py
#!/usr/bin/env python3
"""GPU availability check"""
import sys

def check_gpu():
    try:
        import torch
        if torch.cuda.is_available():
            print(f"✅ GPU available: {torch.cuda.get_device_name(0)}")
            print(f"   CUDA version: {torch.version.cuda}")
            print(f"   GPU count: {torch.cuda.device_count()}")
            return True
        else:
            print("⚠️  CUDA not available")
            return False
    except Exception as e:
        print(f"❌ GPU check failed: {e}")
        return False

if __name__ == '__main__':
    sys.exit(0 if check_gpu() else 1)
EOF

RUN chmod +x /app/gpu_check.py

# Expose ports
EXPOSE 8000 5000

# Volume for persistent data
VOLUME ["/app/data", "/app/logs"]

# Entrypoint (same as base Dockerfile)
COPY --chown=${APP_USER}:${APP_USER} <<'EOF' /app/entrypoint.sh
#!/bin/bash
set -e

echo "🚀 Starting Color Transfer Framework v2.0 (GPU-Enabled)"
echo "📡 Interface: ${INTERFACE}"
echo ""

# Check GPU availability
python /app/gpu_check.py || echo "⚠️  Continuing without GPU"
echo ""

# Copy .env if needed
if [ ! -f /app/.env ]; then
    cp /app/.env.example /app/.env
fi

# Launch interface (same logic as base Dockerfile)
case "${INTERFACE}" in
    api)
        echo "🌐 Starting FastAPI REST API on port ${API_PORT}"
        exec uvicorn color_transfer_framework.interface_layer.api:app \
            --host 0.0.0.0 \
            --port ${API_PORT} \
            --workers ${WORKERS} \
            --log-level info
        ;;
    web)
        echo "🌐 Starting Flask Web UI on port ${WEB_PORT}"
        exec gunicorn color_transfer_framework.interface_layer.web:app \
            --bind 0.0.0.0:${WEB_PORT} \
            --workers ${WORKERS} \
            --log-level info
        ;;
    web_enhanced)
        echo "🌐 Starting Enhanced Flask Web UI on port ${WEB_PORT}"
        exec gunicorn color_transfer_framework.interface_layer.web_enhanced:app \
            --bind 0.0.0.0:${WEB_PORT} \
            --workers ${WORKERS} \
            --log-level info
        ;;
    tui)
        echo "💻 Starting Terminal UI"
        exec python -m color_transfer_framework.interface_layer.tui
        ;;
    cli)
        echo "💻 CLI mode - container running"
        exec tail -f /dev/null
        ;;
    *)
        echo "❌ Unknown interface: ${INTERFACE}"
        exit 1
        ;;
esac
EOF

RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]

# ============================================================================
# GPU Usage Notes
# ============================================================================
#
# Requirements:
# - NVIDIA GPU with CUDA Compute Capability 3.5+
# - NVIDIA Docker runtime installed
# - nvidia-container-toolkit
#
# Installation (Ubuntu):
#   curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | \
#     sudo gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
#   distribution=$(. /etc/os-release;echo $ID$VERSION_ID)
#   curl -s -L https://nvidia.github.io/libnvidia-container/$distribution/libnvidia-container.list | \
#     sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | \
#     sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list
#   sudo apt-get update && sudo apt-get install -y nvidia-container-toolkit
#   sudo systemctl restart docker
#
# Build:
#   docker build -f Dockerfile.gpu -t color-transfer:gpu .
#
# Run:
#   docker run --gpus all -p 8000:8000 color-transfer:gpu
#
# Docker Compose:
#   Add to docker-compose.yml:
#     deploy:
#       resources:
#         reservations:
#           devices:
#             - driver: nvidia
#               count: 1
#               capabilities: [gpu]
#
# Verify GPU:
#   docker run --gpus all color-transfer:gpu python /app/gpu_check.py
#
# ============================================================================
