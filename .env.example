# =============================================================================
# Color Transfer Framework - Environment Configuration
# =============================================================================
#
# Copy this file to .env and customize for your environment
# IMPORTANT: Never commit .env to version control!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your configuration
#   # The framework will automatically load from .env
#
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Options: development, testing, staging, production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# API Server Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Secret key for Flask sessions (generate a random string for production!)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Enable/disable rate limiting globally
RATE_LIMIT_ENABLED=true

# Maximum requests allowed per window
RATE_LIMIT_REQUESTS=100

# Time window in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# Examples:
# - Conservative: 60 requests/60 seconds = 1 req/sec
# - Moderate: 100 requests/60 seconds = 1.67 req/sec  (default)
# - Generous: 1000 requests/60 seconds = 16.67 req/sec
# - High-traffic: 10000 requests/60 seconds = 166.67 req/sec

# -----------------------------------------------------------------------------
# File Upload Limits
# -----------------------------------------------------------------------------
# Maximum file size in megabytes
MAX_FILE_SIZE_MB=100

# Maximum image dimension (width or height) in pixels
MAX_IMAGE_DIMENSION=50000

# Maximum total pixels (width * height)
MAX_IMAGE_PIXELS=100000000

# Examples:
# - Conservative: MAX_FILE_SIZE_MB=10, MAX_DIMENSION=5000
# - Default: MAX_FILE_SIZE_MB=100, MAX_DIMENSION=50000
# - Generous: MAX_FILE_SIZE_MB=500, MAX_DIMENSION=100000

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# CORS allowed origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*

# Require API key for requests
API_KEY_REQUIRED=false

# API key (only if API_KEY_REQUIRED=true)
# Generate with: python -c "import secrets; print('sk_' + secrets.token_urlsafe(32))"
# API_KEY=sk_your-secret-api-key-here

# -----------------------------------------------------------------------------
# Redis Configuration (for distributed caching)
# -----------------------------------------------------------------------------
# Enable Redis caching
REDIS_ENABLED=false

# Redis connection details
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis password (leave empty if no password)
# REDIS_PASSWORD=your-redis-password-here

# Redis database number (0-15)
REDIS_DB=0

# Full Redis URL (alternative to individual settings)
# Format: redis://[:password@]host:port/db
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Celery Configuration (for distributed processing)
# -----------------------------------------------------------------------------
# Enable Celery distributed task processing
CELERY_ENABLED=false

# Celery broker URL (RabbitMQ or Redis)
# RabbitMQ: amqp://user:password@localhost:5672//
# Redis: redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend (where to store task results)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Celery worker concurrency (number of worker processes)
# CELERY_WORKER_CONCURRENCY=4

# -----------------------------------------------------------------------------
# CDN Configuration (for static asset delivery)
# -----------------------------------------------------------------------------
# Enable CDN for result delivery
CDN_ENABLED=false

# CDN provider: local, cloudflare, cloudfront
CDN_PROVIDER=local

# CDN base URL (where assets are served from)
# CDN_BASE_URL=https://cdn.example.com

# CDN API key (if required by provider)
# CDN_API_KEY=your-cdn-api-key-here

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, text
LOG_FORMAT=json

# Log file path (leave empty to log to stdout)
# LOG_FILE=/var/log/color_transfer/app.log

# -----------------------------------------------------------------------------
# Performance & Monitoring
# -----------------------------------------------------------------------------
# Enable performance profiling
ENABLE_PROFILING=false

# Enable metrics collection
ENABLE_METRICS=true

# Metrics history size (number of requests to keep for percentile calculations)
# METRICS_HISTORY_SIZE=1000

# Health check thresholds
HEALTH_CHECK_DISK_MIN_GB=1.0
HEALTH_CHECK_MEMORY_MAX_PERCENT=90.0

# -----------------------------------------------------------------------------
# GPU Configuration
# -----------------------------------------------------------------------------
# Enable GPU acceleration (requires CUDA/PyTorch)
# ENABLE_GPU=false

# GPU device ID (for multi-GPU systems)
# GPU_DEVICE_ID=0

# -----------------------------------------------------------------------------
# Advanced Processing
# -----------------------------------------------------------------------------
# Batch processing: maximum concurrent workers
# BATCH_MAX_WORKERS=4

# Video processing: frame skip (process every Nth frame)
# VIDEO_FRAME_SKIP=1

# Plugin directory path
# PLUGIN_DIR=./plugins

# -----------------------------------------------------------------------------
# Database Configuration (optional, for persistence)
# -----------------------------------------------------------------------------
# Database URL (SQLite, PostgreSQL, MySQL)
# SQLite: sqlite:///./color_transfer.db
# PostgreSQL: postgresql://user:password@localhost/color_transfer
# DATABASE_URL=sqlite:///./color_transfer.db

# -----------------------------------------------------------------------------
# Development/Testing
# -----------------------------------------------------------------------------
# Enable debug mode (NEVER in production!)
DEBUG=false

# Enable Flask debug mode
# FLASK_DEBUG=false

# Enable FastAPI auto-reload
# FASTAPI_RELOAD=false

# Test mode (disable external services)
# TESTING=false

# -----------------------------------------------------------------------------
# Deployment-Specific (Kubernetes, Docker)
# -----------------------------------------------------------------------------
# Pod/Container name (auto-set in Kubernetes)
# POD_NAME=color-transfer-api-12345

# Namespace (auto-set in Kubernetes)
# NAMESPACE=default

# Node name (auto-set in Kubernetes)
# NODE_NAME=node-1

# -----------------------------------------------------------------------------
# Examples for Different Environments
# -----------------------------------------------------------------------------

# Development (.env.development):
# --------------------------------
# ENVIRONMENT=development
# DEBUG=true
# LOG_LEVEL=DEBUG
# RATE_LIMIT_ENABLED=false
# REDIS_ENABLED=false
# CELERY_ENABLED=false

# Testing (.env.testing):
# ------------------------
# ENVIRONMENT=testing
# TESTING=true
# RATE_LIMIT_ENABLED=false
# MAX_FILE_SIZE_MB=10
# ENABLE_METRICS=false

# Production (.env.production):
# ------------------------------
# ENVIRONMENT=production
# SECRET_KEY=<generate-strong-random-key>
# API_KEY_REQUIRED=true
# API_KEY=<generate-api-key>
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=1000
# REDIS_ENABLED=true
# REDIS_HOST=redis-cluster
# REDIS_PASSWORD=<redis-password>
# CELERY_ENABLED=true
# CDN_ENABLED=true
# LOG_LEVEL=WARNING
# DEBUG=false

# =============================================================================
# Notes
# =============================================================================
#
# 1. Boolean values: true/false (case-insensitive)
# 2. Numeric values: Plain numbers (no quotes)
# 3. String values: With or without quotes
# 4. Lists: Comma-separated (e.g., ALLOWED_ORIGINS=http://localhost:3000,https://app.com)
# 5. Empty/unset values: Comment out or leave empty
#
# 6. Loading configuration:
#    - Framework automatically loads from .env in current directory
#    - Override with CONFIG_FILE environment variable
#    - Example: CONFIG_FILE=/path/to/.env.production python app.py
#
# 7. Security best practices:
#    - Never commit .env to git (add to .gitignore)
#    - Use strong random keys (see generation commands above)
#    - Rotate keys regularly
#    - Use secrets management in production (K8s Secrets, AWS SSM, Vault)
#
# 8. For Kubernetes deployment:
#    - Create ConfigMap from .env: kubectl create configmap app-config --from-env-file=.env
#    - Create Secret for sensitive values: kubectl create secret generic app-secrets --from-literal=api_key=xxx
#    - Reference in deployment.yaml
#
# =============================================================================
